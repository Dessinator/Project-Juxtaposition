[resource]
script = ExtResource("2_ssvfn")
full_name = "Desirée January Walker"
nickname = "Dizzy"
internal_name = &"dizzy"
pronouns = ExtResource("2_e8u41")
short_description = "The elusive Strawberry Pie developer itself. Incredibly eccentric, borderline insane. It is unknown how long it has inhabited this game."
long_description = "Dizzy, the elusive Strawberry Pie developer, is widely known as the creator of this game. Whatever it has done, it's the reason why its victims are helpless to escape. Known for its enjoyment of niche game mechanics - and the rain, which it can often be seen jumping in puddles and whacking Entities with its umbrella. It could only be in here by choice. One shudders to think about what true power it could hold over the players despite how carefree and almost friendly it might seem on the surface."
dissociation = -1.0
light_attack_talents = Array[ExtResource("1_4i56b")]([ExtResource("5_3tq0e"), ExtResource("6_df4dd")])
heavy_attack_talents = Array[ExtResource("1_4i56b")]([ExtResource("3_df4dd")])
